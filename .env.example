# npm run login 自动填写以下两项；只保存本地或 Actions Secrets。
TAPTAP_COOKIE=
TAPTAP_DEVELOPER_ID=
# 每轮最多处理 40 款，已完成当日采集的游戏跳过；请求默认间隔 3 秒。
TAPMONEY_BATCH_SIZE=40
# 同时处理的游戏数（1–10）；请求启动间隔由下一项统一控制，并发不会绕过间隔。
TAPMONEY_CONCURRENCY=1
TAPTAP_REQUEST_DELAY_MS=3000

# 可选公开 JSON 镜像；默认使用 TapMoney 主分支的 jsDelivr 快照。
TAPMONEY_DATA_URL=

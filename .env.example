# npm run login 自动填写以下两项；只保存本地或 Actions Secrets。
TAPTAP_COOKIE=
TAPTAP_DEVELOPER_ID=
# 每轮最多处理 40 款，已完成当日采集的游戏跳过；请求默认间隔 3 秒。
TAPMONEY_BATCH_SIZE=40
# 同时处理的游戏数（1–10）；请求启动间隔由下一项统一控制，并发不会绕过间隔。
TAPMONEY_CONCURRENCY=1
TAPTAP_REQUEST_DELAY_MS=3000

# 默认 repository：config/ 为来源，生成纯静态网站。
# 可选 cloud：Pages Functions + D1 在线管理。
TAPMONEY_CONFIG_SOURCE=repository
CLOUDFLARE_PAGES_PROJECT=tapmoney
CLOUDFLARE_ACCOUNT_ID=
# 本地也可通过 npm exec wrangler login 使用 OAuth。
CLOUDFLARE_API_TOKEN=

# 可选公开 JSON 镜像（如固定 commit 的 jsDelivr URL）；留空使用同源数据。
TAPMONEY_DATA_URL=

# 仅 cloud 模式需要；管理 Token 不属于公开网站数据。
TAPMONEY_API_URL=
TAPMONEY_ADMIN_TOKEN=
TAPMONEY_D1_DATABASE=tapmoney-db

# 可选：npm run collect:setup 配置管理页手动采集，也可通过 --token-file 读取。
# 仅限目标仓库的 GitHub fine-grained Token，Actions 读写权限；仅保存为 Pages Secret。
TAPMONEY_COLLECT_TOKEN=
